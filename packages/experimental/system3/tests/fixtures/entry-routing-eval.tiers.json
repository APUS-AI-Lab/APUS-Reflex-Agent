{
  "version": 1,
  "deployed": true,
  "description": "Four-tier entry routing over the deployed System3 candidates. Tier labels are the set author's judgement; follow-ups refer to history the router does not receive and expect abstain.",
  "baseline": {
    "provider": "fidoo",
    "model": "deepseek-v4-flash",
    "reasoningEffort": "low"
  },
  "candidates": [
    {
      "id": "fast",
      "description": "简短问答、翻译、改写、归纳，以及范围明确、一步就能完成的常规任务。",
      "provider": "fidoo",
      "model": "deepseek-v4-flash",
      "reasoningEffort": "low"
    },
    {
      "id": "reasoning",
      "description": "需要几步推理的分析：解释原理、比较方案、阅读和排查一段代码、中等规模的计算或推导。",
      "provider": "fidoo",
      "model": "deepseek-v4-pro",
      "reasoningEffort": "low"
    },
    {
      "id": "expert",
      "description": "约束多、跨度大的专业任务：完整系统设计、跨模块代码改造、长篇材料综合，以及需要权衡依赖与风险的方案。",
      "provider": "fidoo-relay",
      "model": "gpt-5.6-sol-relay",
      "reasoningEffort": "medium"
    },
    {
      "id": "frontier",
      "description": "最难的一类问题：开放式研究、严格证明、前沿难题，以及前几档模型很可能无法可靠完成的任务。",
      "provider": "fidoo-relay",
      "model": "gpt-6-sol-relay",
      "reasoningEffort": "high"
    }
  ],
  "tasks": [
    {
      "id": "fast-01",
      "input": "把“请在周五前提交报告”翻译成英文。",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "fast-02",
      "input": "Python 里怎么把字符串转成小写？",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "fast-03",
      "input": "用一句话解释什么是 API。",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "fast-04",
      "input": "把这句话改得更礼貌：你这个方案不行，重做。",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "fast-05",
      "input": "列出 Linux 查看磁盘占用的常用命令。",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "fast-06",
      "input": "2026-10-02 是星期几？",
      "expected": "fast",
      "tag": "standalone"
    },
    {
      "id": "reasoning-01",
      "input": "为什么 TCP 建立连接需要三次握手而不是两次？说明两次握手会出什么问题。",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "reasoning-02",
      "input": "读多写少的商品详情接口，用旁路缓存还是读写穿透缓存？比较两者并给出建议。",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "reasoning-03",
      "input": "这段代码为什么会漏掉最后一个元素：for i in range(len(a) - 1): total += a[i]",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "reasoning-04",
      "input": "每月定投 2000 元，年化 6%，按月复利，5 年后本息合计大约多少？给出计算过程。",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "reasoning-05",
      "input": "一个查询按 created_at 排序取前 20 条却很慢，表上只有 user_id 索引，分析原因并给出改法。",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "reasoning-06",
      "input": "解释快速排序最坏情况为什么是 O(n²)，以及随机化如何缓解。",
      "expected": "reasoning",
      "tag": "standalone"
    },
    {
      "id": "expert-01",
      "input": "我们有一个日订单 500 万的单体订单系统，要拆成微服务。请设计拆分边界、数据一致性方案、灰度迁移步骤和每一步的回滚方式。",
