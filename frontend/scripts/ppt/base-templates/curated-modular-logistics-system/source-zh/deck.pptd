version: v2
title: 中国跨境电商：从流量出海到本地经营
size:
  - 960
  - 540
template:
  id: dsh-work-curated-modular-logistics-system
  name: Modular Logistics System
theme:
  colors:
    paper: '#F2F2EE'
    surface: '#FFFFFF'
    graphite: '#202224'
    slate: '#60666A'
    grid: '#D9DCD8'
    yellow: '#FFD400'
    yellowPale: '#FFF3A6'
    steel: '#AEB4B5'
    risk: '#C84B31'
    white: '#FFFFFF'
  textStyles:
    display:
      fontFamily: &ref_0
        latin: Arial
        ea: Noto Sans CJK SC
        mac: PingFang SC
        win: Microsoft YaHei
      fontSize: 56
      color: $graphite
      bold: true
      lineHeight: 1.02
    pageTitle:
      fontFamily: *ref_0
      fontSize: 29
      color: $graphite
      bold: true
      lineHeight: 1.08
    section:
      fontFamily: &ref_1
        latin: Arial
        ea: Noto Sans CJK SC
        mac: PingFang SC
        win: Microsoft YaHei
      fontSize: 10
      color: $slate
      bold: true
      letterSpacing: 1.4
    body:
      fontFamily: *ref_1
      fontSize: 14
      color: $graphite
      lineHeight: 1.22
    small:
      fontFamily: *ref_1
      fontSize: 9
      color: $slate
      lineHeight: 1.18
    metric:
      fontFamily: *ref_0
      fontSize: 44
      color: $graphite
      bold: true
    label:
      fontFamily: *ref_1
      fontSize: 9
      color: $graphite
      bold: true
      letterSpacing: 1
  tableStyles:
    operations:
      cellStyle:
        fontFamily: *ref_1
        fontSize: 10
        color: $graphite
        fill:
          type: solid
          color: $surface
        border:
          width: 0.8
          color: $grid
        align:
          - left
          - middle
      firstRowStyle:
        fill:
          type: solid
          color: $graphite
        color: $white
        bold: true
        align:
          - center
          - middle
pages:
  - pages/page-01-cover.page
  - pages/page-02-summary.page
  - pages/page-03-scale.page
  - pages/page-04-structure.page
  - pages/page-05-concentration.page
  - pages/page-06-warehouse.page
  - pages/page-07-models.page
  - pages/page-08-capabilities.page
  - pages/page-09-entry.page
  - pages/page-10-actions.page
